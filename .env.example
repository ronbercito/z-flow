# Z-FLOW local/container environment
# Copy this file to .env before starting.

WEB_PORT=8080
API_PORT=3001

DB_NAME=zflow
DB_USER=zflow
DB_PASSWORD=change_this_local_password
DB_ROOT_PASSWORD=change_this_root_password

# Authentication/session
SESSION_HOURS=12
COOKIE_SECURE=false

# Local stage: no domain/HTTPS yet.
# Open from another device using:
# http://IP_DEL_CONTENEDOR:8080
#
# On the first API start, if there are no users, Z-FLOW creates:
# - one OWNER account
# - one Miraflores branch account
# with random temporary passwords printed once in the API logs.
